# Copy to .env and fill in. NEVER commit .env.

# --- LLM providers (fill in the ones you use) ---
OPENAI_API_KEY=sk-...
# Only needed if a step is switched to anthropic:..., or for the v1 agent tasks.
ANTHROPIC_API_KEY=

# Default model per pipeline step, as provider:model. The /settings page
# overrides these at runtime (stored in the database).
LLM_CLASSIFY=openai:gpt-6-luna
LLM_WRITE=openai:gpt-6-luna
LLM_DIGEST=openai:gpt-6-luna

# Model for the v1 agent tasks (kind: agent in tasks.yml; all mode: off for now)
CLAUDE_MODEL=claude-sonnet-5

# --- Site repo ---
# Fine-grained PAT, only rvanbruggen/educaition, permission "Contents: read and write"
GITHUB_TOKEN=github_pat_...
GITHUB_REPO=rvanbruggen/educaition
GIT_USER_NAME=Rik Van Bruggen
GIT_USER_EMAIL=rik.vanbruggen@gmail.com

# Optional: protect the web UI with HTTP Basic auth (user "rik").
# Leave empty for no auth (fine on a trusted home LAN).
ADMIN_PASSWORD=

# Host port for the web UI (the container listens on 8080 internally).
RUNNER_PORT=8090

TZ=Europe/Brussels
