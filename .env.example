# Copy to .env and fill in. NEVER commit .env.

# Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Model for the agent runs (cost/quality trade-off)
CLAUDE_MODEL=claude-sonnet-5

# GitHub personal access token with repo write access to the site repo
GITHUB_TOKEN=github_pat_...
GITHUB_REPO=rvanbruggen/educaition
GIT_USER_NAME=Rik Van Bruggen
GIT_USER_EMAIL=rik.vanbruggen@gmail.com

# Optional: protect the web UI with HTTP Basic auth (user "rik").
# Leave empty for no auth (fine on a trusted home LAN).
ADMIN_PASSWORD=

TZ=Europe/Brussels
